<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Leux.BudgetPage"
             Title="Budget Management">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Add Budget" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

            <Entry x:Name="categoryInput" Placeholder="Category" />
            <Entry x:Name="limitInput" Placeholder="Limit ($)" Keyboard="Numeric" />
            <Entry x:Name="spentInput" Placeholder="Spent ($)" Keyboard="Numeric" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>