<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Leux.Resources.Pages"
             x:Class="Leux.DashboardPage"
             xmlns:models="clr-namespace:Leux.Resources.Models"
             Title="Dashboard"
             Shell.NavBarIsVisible="False">

    <!-- THEME -->
    <ContentPage.Resources>
        <Color x:Key="Bg0">#121214</Color>
        <Color x:Key="CardBg">#1E1F25</Color>
        <Color x:Key="CardStroke">#2C2D33</Color>
        <Color x:Key="TextMain">#F5F6F8</Color>
        <Color x:Key="TextSub">#B9BCC2</Color>
        <Color x:Key="AccentViolet">#7C5CFF</Color>
        <Color x:Key="AccentBlue">#4C7DFF</Color>
        <Color x:Key="AccentIndigo">#5E6AD2</Color>
        <Color x:Key="DangerRed">#E5484D</Color>
        <Color x:Key="ChipBg">#2A2B32</Color>

        <Style TargetType="ContentPage">
            <Setter Property="BackgroundColor" Value="{StaticResource Bg0}" />
        </Style>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6E5DFF" Offset="0.0"/>
            <GradientStop Color="#3940A7" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StatCardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8C7BFF" Offset="0.0"/>
            <GradientStop Color="#4B59D6" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
            <Setter Property="BorderColor" Value="{StaticResource CardStroke}" />
            <Setter Property="HasShadow" Value="False" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#00000000"/>
            <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentViolet}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}"/>
        </Style>

        <Style x:Key="H1" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="KPIValue" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KPIHeading" TargetType="Label">
            <Setter Property="TextColor" Value="#EAEAF2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Frame Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                <Grid Padding="18,14">
                    <Grid.Background>
                        <StaticResource Key="HeaderGradient"/>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Leux" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Welcome back!" Style="{StaticResource Muted}" TextColor="#EAEAF2"/>
                    </VerticalStackLayout>

                </Grid>
            </Frame>

            <local:NavigationHeader Grid.Row="1" />

            <!-- CENTERED WRAP -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Grid.Column="1" Spacing="14" WidthRequest="960" MaximumWidthRequest="960">

                    <!-- KPI CARDS -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Today's Spending -->
                        <Frame Grid.Column="0" CornerRadius="18" Padding="14" HasShadow="False">
                            <Frame.Background>
                                <StaticResource Key="StatCardGradient"/>
                            </Frame.Background>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Today's Spending" Style="{StaticResource KPIHeading}" />
                                <Label x:Name="TodayTotalLabel" Text="$0.00" Style="{StaticResource KPIValue}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- This Week -->
                        <Frame Grid.Column="1" CornerRadius="18" Padding="14" HasShadow="False">
                            <Frame.Background>
                                <StaticResource Key="StatCardGradient"/>
                            </Frame.Background>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="This Week" Style="{StaticResource KPIHeading}" />
                                <Label x:Name="WeekTotalLabel" Text="$0.00" Style="{StaticResource KPIValue}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- This Month -->
                        <Frame Grid.Column="2" CornerRadius="18" Padding="14" HasShadow="False">
                            <Frame.Background>
                                <StaticResource Key="StatCardGradient"/>
                            </Frame.Background>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="This Month" Style="{StaticResource KPIHeading}" />
                                <Label x:Name="MonthTotalLabel" Text="$0.00" Style="{StaticResource KPIValue}" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- QUICK ADD -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Quick Add Expense" Style="{StaticResource H1}"/>

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Entry x:Name="DescEntry"
                                       Grid.Column="0"
                                       Placeholder="Description"
                                       TextColor="{StaticResource TextMain}"
                                       PlaceholderColor="{StaticResource TextSub}"
                                       BackgroundColor="{StaticResource CardBg}"/>

                                <Entry x:Name="AmountEntry"
                                       Grid.Column="1"
                                       Keyboard="Numeric"
                                       Placeholder="Amount"
                                       TextColor="{StaticResource TextMain}"
                                       PlaceholderColor="{StaticResource TextSub}"
                                       BackgroundColor="{StaticResource CardBg}"/>

                                <Picker x:Name="CategoryPicker"
                                        Grid.Column="2"
                                        Title="Category"
                                        TextColor="{StaticResource TextMain}"
                                        BackgroundColor="{StaticResource CardBg}">
                                    <Picker.Items>
                                        <x:String>Food &amp; Drink</x:String>
                                        <x:String>Shopping</x:String>
                                        <x:String>Transport</x:String>
                                        <x:String>Entertainment</x:String>
                                        <x:String>Other</x:String>
                                    </Picker.Items>
                                </Picker>

                                <DatePicker x:Name="ExpenseDatePicker"
                                        Grid.Row="3" Grid.Column="3" />

                                <Button Grid.Column="4"
                                        Text="Add"
                                        Style="{StaticResource PrimaryButton}"
                                        Clicked="OnAddExpenseClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- TODAY'S EXPENSES -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Recent Expenses" Style="{StaticResource H1}"/>

                        <ActivityIndicator x:Name="LoadingSpinner"
                          IsVisible="false"
                          IsRunning="true"
                          Color="{StaticResource Primary}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          HeightRequest="50"
                          WidthRequest="50" />

                        <CollectionView x:Name="TodayList"
                                        ItemsSource="{Binding Today}"
                                        EmptyView="No expenses yet today.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Style="{StaticResource Card}">
                                        <Grid ColumnSpacing="10" RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <VerticalStackLayout Spacing="6">
                                                <!-- Category chip using Border (rounded) -->
                                                <Border BackgroundColor="{StaticResource ChipBg}"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="8,2"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding Category}"
                                                           TextColor="{StaticResource TextSub}"
                                                           FontSize="12"/>
                                                </Border>

                                                <Label Text="{Binding Description}"
                                                       TextColor="{StaticResource TextMain}"
                                                       FontSize="16"/>

                                                <Label Text="{Binding OccurredAt, StringFormat='{}{0:MMM d, h:mm tt}'}"
                                                       Style="{StaticResource Muted}"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Amount, StringFormat='${0:F2}'}"
                                                   TextColor="{StaticResource TextMain}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>

                                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                                <Button Text="Edit" Clicked="OnEditClicked" Style="{StaticResource TabButton}"/>
                                                <Button Text="Delete" Clicked="OnDeleteClicked" Style="{StaticResource DangerButton}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <ContentView Grid.Row="4" HeightRequest="12"/>
        </Grid>
    </ScrollView>
</ContentPage>
