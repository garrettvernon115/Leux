<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Leux.Resources.Pages.DashboardPage"
             Title="DashboardPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <!-- Top Metrics Section -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" ColumnSpacing="15">
                <Label Text="This Month:" Grid.Column="0" />
                <Label Text="This Week:" Grid.Column="1" />
                <Label Text="Prev Month:" Grid.Column="2" />
            </Grid>


        </VerticalStackLayout>
        
     
    </ScrollView>       
    
    
    
    
    
    
</ContentPage>