<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Leux.ProfilePage"
             Title="Profile" >

    <!-- Center the card on screen -->
    <Grid RowDefinitions="*,Auto,*" Padding="24">
        <Frame Grid.Row="1"
           Padding="24"
           HasShadow="False"
           CornerRadius="14"
           HorizontalOptions="Center"
           WidthRequest="720"
           MaximumWidthRequest="840"
           BackgroundColor="{AppThemeBinding Light='#ffffff', Dark='#1E1E1E'}">

            <ScrollView>
                <VerticalStackLayout Spacing="14">

                    <!-- Title -->
                    <Label Text="Profile"
                 FontSize="24"
                 HorizontalOptions="Center"
                 HorizontalTextAlignment="Center" />

                    <BoxView HeightRequest="1" Opacity="0.12" />

                    <!-- First / Last row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="0" Padding="0">
                        <!-- First Name -->
                        <VerticalStackLayout Spacing="6" Grid.Column="0">
                            <Label Text="First Name" />
                            <Entry x:Name="FirstNameEntry"
                     Placeholder="First name"
                     HeightRequest="40" />
                        </VerticalStackLayout>

                        <!-- Last Name -->
                        <VerticalStackLayout Spacing="6" Grid.Column="1">
                            <Label Text="Last Name" />
                            <Entry x:Name="LastNameEntry"
                     Placeholder="Last name"
                     HeightRequest="40" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address" />
                        <Entry x:Name="EmailEntry"
                   Placeholder="you@example.com"
                   Keyboard="Email"
                   HeightRequest="40" />
                    </VerticalStackLayout>

                    <!-- DOB typed -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Date of Birth (MM/DD/YYYY)" />
                        <Entry x:Name="DobEntry"
                   Placeholder="MM/DD/YYYY"
                   Keyboard="Numeric"
                   HeightRequest="40" />
                    </VerticalStackLayout>

                    <!-- Recovery Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Recovery Email" />
                        <Entry x:Name="RecoveryEmailEntry"
                   Placeholder="backup@example.com"
                   Keyboard="Email"
                   HeightRequest="40" />
                    </VerticalStackLayout>

                    <!-- Currency -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Currency" />
                        <Picker x:Name="CurrencyPicker" HeightRequest="40">
                            <Picker.Items>
                                <x:String>USD</x:String>
                                <x:String>EUR</x:String>
                                <x:String>GBP</x:String>
                                <x:String>CAD</x:String>
                                <x:String>XOF</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!-- Notifications -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                        <Label Text="Enable Notifications" VerticalTextAlignment="Center" />
                        <Switch x:Name="NotificationsSwitch" Grid.Column="1" />
                    </Grid>

                    <!-- Monthly Budget (text field) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Monthly Budget ($)" />
                        <Entry x:Name="BudgetEntry"
                   Placeholder="e.g., 500"
                   Keyboard="Numeric"
                   HeightRequest="40" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Opacity="0.12" />

                    <!-- Actions -->
                    <VerticalStackLayout Spacing="10">
                        <Button Text="Save Changes"
                    Clicked="OnSaveClicked"
                    CornerRadius="10"
                    HeightRequest="44" />
                        <Button Text="Change Password"
                    Clicked="OnChangePassword"
                    BackgroundColor="Transparent" />
                        <Button Text="Sign Out"
                    Clicked="OnSignOut"
                    BackgroundColor="#FF3B30"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</ContentPage>
